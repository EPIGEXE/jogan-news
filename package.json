{
  "name": "ai-news",
  "productName": "AINews",
  "version": "0.0.1",
  "private": true,
  "description": "AI 데일리 브리핑 데스크톱 앱",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "eval:collect": "tsx --tsconfig tsconfig.node.json scripts/eval/collect.ts",
    "eval:llm": "tsx --tsconfig tsconfig.node.json scripts/eval/run.ts",
    "pipeline": "tsx --tsconfig tsconfig.node.json scripts/run-pipeline.ts",
    "lint:tokens": "node scripts/lint-tokens.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.6",
    "groq-sdk": "^1.6.0",
    "linkedom": "^0.18.13",
    "p-limit": "^7.3.3",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/hahmlet": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-vite": "^5.0.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
